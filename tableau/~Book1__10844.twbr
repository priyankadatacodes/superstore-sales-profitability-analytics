      <aliases enabled='yes' />
      <column caption='Box' datatype='string' name='[Calculation_1677027951060279297]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='zero' datatype='integer' name='[Calculation_1923881508623773699]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Metric Value' datatype='real' name='[Calculation_1923881508645036038]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Sales&quot; THEN SUM([Sales])&#13;&#10;WHEN &quot;Profit&quot; THEN SUM([Profit])&#13;&#10;WHEN &quot;Profit Margin %&quot; THEN SUM([Profit]) / SUM([Sales])&#13;&#10;WHEN &quot;Orders&quot; THEN COUNTD([Order ID])&#13;&#10;END' />
      </column>
      <column caption='profit ratio' datatype='real' name='[Calculation_1923881508711055368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
      </column>
      <column caption='ProfitMargin %' datatype='real' default-format='p0.00%' name='[Calculation_918171412359798785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
      </column>
      <column caption='Profit Status' datatype='string' name='[Calculation_918171412360192002]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Profit]) &gt;= 0 THEN &quot;Profitable&quot; ELSE &quot;Loss&quot; END' />
      </column>
      <column caption=' Discount Bucket Sort' datatype='integer' name='[Calculation_918171412360351747]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Discount Bucket]&#13;&#10;WHEN &quot;0%&quot; THEN 1&#13;&#10;WHEN &quot;1-10%&quot; THEN 2&#13;&#10;WHEN &quot;11-20%&quot; THEN 3&#13;&#10;WHEN &quot;21-30%&quot; THEN 4&#13;&#10;WHEN &quot;31-40%&quot; THEN 5&#13;&#10;WHEN &quot;41-50%&quot; THEN 6&#13;&#10;WHEN &quot;&gt;50%&quot; THEN 7&#13;&#10;END' />
      </column>
      <column caption=' State Sales' datatype='real' name='[Calculation_918171412360474628]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [State] : SUM([Sales]) }' />
      </column>
      <column caption='State Profit' datatype='real' name='[Calculation_918171412360577029]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [State] : SUM([Profit]) }' />
      </column>
      <column caption='Median State Sales' datatype='real' name='[Calculation_918171412360667142]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : MEDIAN([Calculation_918171412360474628]) }' />
      </column>
      <column caption='Median State Profit' datatype='real' name='[Calculation_918171412360867847]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : MEDIAN([Calculation_918171412360577029]) }' />
      </column>
      <column caption='Quadrant' datatype='string' name='[Calculation_918171412360990728]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_918171412360474628] &gt;= [Calculation_918171412360667142] AND [Calculation_918171412360577029] &gt;= [Calculation_918171412360867847] THEN &quot;Stars&quot;&#13;&#10;ELSEIF [Calculation_918171412360474628] &gt;= [Calculation_918171412360667142] AND [Calculation_918171412360577029] &lt; [Calculation_918171412360867847] THEN &quot;Risk&quot;&#13;&#10;ELSEIF [Calculation_918171412360474628] &lt; [Calculation_918171412360667142] AND [Calculation_918171412360577029] &gt;= [Calculation_918171412360867847] THEN &quot;Growth&quot;&#13;&#10;ELSE &quot;Weak&quot;&#13;&#10;END' />
      </column>
      <column caption='Sales YoY Growth %' datatype='real' name='[Calculation_918171412361580553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([Sales])) - LOOKUP(ZN(SUM([Sales])), -1)) / ABS(LOOKUP(ZN(SUM([Sales])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Avg Order Value' datatype='real' name='[Calculation_918171412361695242]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) / COUNTD([Order ID])' />
      </column>
